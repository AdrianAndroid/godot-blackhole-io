; Engine configuration file.
; Edit through the Godot editor when possible.
config_version=5

[application]

config/name="Blackhole City"
config/description="视频参考的实时 3D 黑洞吞噬单机原型"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=432
window/size/viewport_height=960
window/size/window_width_override=432
window/size/window_height_override=960
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
scaling_3d/scale=1.0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.12, 1)
